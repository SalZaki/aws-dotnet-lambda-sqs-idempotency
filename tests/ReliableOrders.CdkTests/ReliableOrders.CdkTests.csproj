<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ReliableOrders.CdkTests</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\infra\ReliableOrders.Cdk\ReliableOrders.Cdk.csproj" />
    <!--
      For FunctionConfiguration's variable names. The environment the stack sets and the environment
      the function reads are one contract, and asserting it against the constants rather than against
      string literals means a rename fails this build instead of the first invocation after a deploy.
      A test-only reference: the CDK app itself does not depend on the function it deploys.
    -->
    <ProjectReference Include="..\..\src\ReliableOrders.Function\ReliableOrders.Function.csproj" />
    <!--
      For the constants the local development stack copies out of the CDK — the queue names and the
      redrive setting — which LocalStackParityTests holds in step with the synthesised template. A
      test-only reference in the same direction as the one above: nothing deployed depends on the
      local stack.
    -->
    <ProjectReference Include="..\..\local\ReliableOrders.Local\ReliableOrders.Local.csproj" />
  </ItemGroup>

  <!--
    The end-to-end suite copies two deployment names it cannot reference — taking them from the CDK
    project would pull Amazon.CDK.Lib and jsii into a suite whose whole job is to talk to an account.
    Referenced here so one case can hold the copies in step with the construct, the way the local
    stack's are.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ReliableOrders.EndToEndTests\ReliableOrders.EndToEndTests.csproj" />
  </ItemGroup>

  <!--
    The tests synthesise with the deployed context rather than an empty one. Feature flags change what
    a construct emits, and the CLI reads them from this file while a bare App in a test does not, so
    without it the suite asserts a template no deployment produces. Copied rather than duplicated, so
    the two cannot drift.
  -->
  <ItemGroup>
    <None Include="..\..\infra\ReliableOrders.Cdk\cdk.json"
          Link="cdk.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Amazon.CDK.Lib arrives through the project reference and carries the assertions module with it. It
    is named here as well because these tests compile against Amazon.CDK.Assertions directly, and a
    project that uses a package should say so rather than rely on what a reference happens to bring.
  -->
  <ItemGroup>
    <PackageReference Include="Amazon.CDK.Lib" />
    <PackageReference Include="Cdklabs.CdkNag" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
