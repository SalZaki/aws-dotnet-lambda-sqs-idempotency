<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ReliableOrders.UnitTests</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReliableOrders.Core\ReliableOrders.Core.csproj" />
    <ProjectReference Include="..\..\src\ReliableOrders.Aws\ReliableOrders.Aws.csproj" />
    <!--
      The console formatter is a hosting concern and lives in the function project, but what it writes
      is the log contract the redaction cases assert on, so it is exercised here rather than left to
      an integration suite that would need a deployed log group to observe the same bytes.
    -->
    <ProjectReference Include="..\..\src\ReliableOrders.Function\ReliableOrders.Function.csproj" />
    <!--
      The local development stack is not deployed and no test starts it, but the environment it reads
      is parsed by code with the same failure modes as the function's own — a missing variable, a
      value the type cannot hold — and the same obligation to name what an operator has to go and fix.
      Covered here rather than beside the stack's parity cases, which need a synthesised template.
    -->
    <ProjectReference Include="..\..\local\ReliableOrders.Local\ReliableOrders.Local.csproj" />
  </ItemGroup>

  <!--
    The samples are the fixtures the publisher and the end-to-end scenarios use as well. Copying them
    rather than keeping a second copy here is what stops the suites drifting apart.
  -->
  <ItemGroup>
    <None Include="..\..\samples\*.json"
          Link="Samples\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The known-answer vectors are data the tests read at runtime rather than compile against, so they
    have to reach the output directory. Kept in this project rather than in samples/ because nothing
    else may use them: a fixture that another suite is free to edit is not a committed constant.
  -->
  <ItemGroup>
    <None Update="Vectors\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!--
      Enables the XPlat Code Coverage data collector, which the test command asks for by name. Only
      this project carries it. The architecture tests read lock files rather than exercising the code,
      and the integration tests are filtered out of the run that collects, so both would report near
      zero and say nothing. Adding it there would mean publishing two reports that need explaining.
      PrivateAssets keeps it out of anything referencing this project: it is tooling, not a dependency.
    -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
