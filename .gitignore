## NuGet
# packages.lock.json is committed and nothing here matches it, so no negation is needed.
*.nupkg
*.snupkg
.nuget/
packages/

## AWS CDK
# cdk.context.json is deliberately NOT ignored. It caches environmental lookups made during synth,
# such as availability zones and AMI IDs. Uncommitted, every machine resolves them afresh and synth
# stops being reproducible, which is the opposite of what the pinned SDK and lock files are for.
cdk.out/
.cdk.staging/
# The outputs file a deployment writes, which the README tells a reader to keep beside cdk.json. It
# names queue URLs and roles, and both carry the account ID this repository's workflows mask.
outputs.json

## AWS Lambda tooling
*.zip
!samples/**/*.zip

## Local environment. Never commit credentials; see docs/security.md.
.env
.env.*
# The example file carries variable names and no values, and is meant to be read by contributors.
!.env.example
*.pem
*.key
aws-lambda-tools-defaults.local.json
appsettings.Development.local.json

## OS
.DS_Store
Thumbs.db

## Node, used only by the markdownlint workflow
node_modules/

## Python
# The scripts here are run rather than imported, with one exception: the link checker's suite loads
# it by path, and CPython writes a cache for what it loads.
__pycache__/
*.pyc
