<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    <clear /> drops any feed inherited from a machine-level or user-level NuGet.config. Without it,
    the resolved package set depends on who is building, and a private feed on a contributor's
    machine could shadow a nuget.org package name.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    With one source this maps everything to the only feed available, which sounds like a no-op. Its
    value is what happens next: once any mapping exists, NuGet serves packages only from mapped
    sources, so a second feed added later resolves nothing until someone writes down which package
    patterns it owns. That turns adding a feed into a deliberate, reviewable act.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    No signatureValidationMode here. The only value that verifies anything is "require", and the
    NuGet client honours it on Windows alone, so setting it would give Linux builds and CI the
    appearance of a supply-chain control without the substance. Package integrity rests on the
    committed lock files, which pin a contentHash per package, and on NuGet audit.
  -->

</configuration>
