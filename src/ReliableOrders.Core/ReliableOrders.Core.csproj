<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ReliableOrders.Core</RootNamespace>
    <Description>
      Transport-neutral domain: event contract, validation, canonical hashing, idempotency model and
      message processing. This project must never reference AWSSDK.* or Amazon.Lambda.*; the rule is
      asserted by ReliableOrders.ArchitectureTests.
    </Description>
  </PropertyGroup>

  <!--
    The canonical types under Idempotency/ are internal: they are the hash input, not a contract
    anyone outside this assembly should build against. They still need direct testing, because the
    bytes they produce are what every stored idempotency record was compared on, and reaching them
    only through a hash would leave a canonicalisation change visible as nothing more than a different
    hexadecimal string.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="ReliableOrders.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
