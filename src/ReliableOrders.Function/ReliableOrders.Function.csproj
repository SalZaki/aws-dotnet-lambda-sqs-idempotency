<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ReliableOrders.Function</RootNamespace>
    <AWSProjectType>Lambda</AWSProjectType>
    <Description>
      Lambda composition root. A class-library handler, not an executable assembly: the managed
      runtime loads the assembly and the serializer arrives by assembly-level attribute. See the
      Composition Root section of docs/architecture.md.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReliableOrders.Core\ReliableOrders.Core.csproj" />
    <ProjectReference Include="..\ReliableOrders.Aws\ReliableOrders.Aws.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" />
    <PackageReference Include="Amazon.Lambda.SQSEvents" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!--
      The console provider is a hosting decision and lives here rather than in Core, which takes
      Microsoft.Extensions.Logging.Abstractions alone. Standard output is the whole log transport on
      Lambda; see LoggingConfiguration.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <!--
      The OpenTelemetry SDK is a hosting decision for the same reason. Spans are started from
      ActivitySource in Core and Aws, which is in the framework; these turn them into exported
      telemetry. See TracingConfiguration.
    -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.AWS" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AWS" />
  </ItemGroup>

</Project>
