<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ReliableOrders.Cdk</RootNamespace>
    <OutputType>Exe</OutputType>
    <Description>
      The AWS CDK application. One stack per environment, divided into constructs that each own a
      group of resources.
    </Description>
    <!--
      The CDK CLI is installed here by npm, and it ships C# init templates under node_modules. The
      SDK's default globs would compile them, and they are templates rather than code:
      %name.PascalCased% is not an identifier, so the build fails in a package nobody edited.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.CDK.Lib" />
    <PackageReference Include="Constructs" />
  </ItemGroup>

</Project>
