<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- AWS. Permitted in ReliableOrders.Aws and ReliableOrders.Function only, never in Core. -->
  <ItemGroup>
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.103.3" />
    <!--
      SQS is a test-only dependency. Nothing in src calls the SQS API: the event source mapping
      delivers records and the response tells Lambda what to redeliver, so the service never sends,
      receives, or deletes a message. The integration suite does all three, because that is what
      standing in for the mapping requires.
    -->
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.9" />
    <PackageVersion Include="Amazon.Lambda.Core" Version="3.3.0" />
    <PackageVersion Include="Amazon.Lambda.SQSEvents" Version="3.0.1" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
  </ItemGroup>

  <!--
    CDK. Permitted in ReliableOrders.Cdk and ReliableOrders.CdkTests only. Amazon.CDK.Lib carries the
    assertions module as well as the resource library, so the test project needs no second package.
    Constructs is a direct reference rather than a transitive one because every construct in this
    repository derives from it.
  -->
  <ItemGroup>
    <PackageVersion Include="Amazon.CDK.Lib" Version="2.266.0" />
    <PackageVersion Include="Constructs" Version="10.8.1" />
    <!--
      cdk-nag, in the CDK app and its tests. Nothing it touches is deployed: the app runs at synthesis
      and the rules are evaluated there, which is the point — registering the pack on the app is what
      makes cdk synth and cdk deploy check the same template the suite does.
    -->
    <PackageVersion Include="Cdklabs.CdkNag" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <!--
      Abstractions only in Core: it carries ILogger and EventId and no provider, so the domain can
      describe what happened without choosing where it is written. The console provider below is a
      hosting decision and is referenced by ReliableOrders.Function alone.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

  <!--
    OpenTelemetry. Permitted in ReliableOrders.Function only. The spans themselves are started from
    System.Diagnostics.ActivitySource, which is in the framework, so Core and Aws are instrumented
    without referencing any of this — an SDK is what turns those spans into exported telemetry, and
    that is a hosting decision. Kept on one version across the four packages, which OpenTelemetry
    ships in lockstep and does not support mixing.
  -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.AWS" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AWS" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <!--
      Transitive, and pinned rather than referenced. Testcontainers 4.13.0 is the current release and
      still resolves SSH.NET 2025.1.0, which carries GHSA-q939-rpr3-3284 — a high-severity advisory
      that NuGetAudit turns into a restore failure. Central transitive pinning lifts it to the fixed
      version without waiting for Testcontainers to move. Remove this once Testcontainers resolves
      2026.0.0 or later on its own.
    -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
